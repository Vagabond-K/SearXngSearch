{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SearXng": {
    "BaseUrl": "http://localhost:8080",
    "ApiKey": null,
    "TimeoutSeconds": 30,
    "DefaultMaxResults": 10,
    "MaxResultsLimit": 30,
    "DefaultLanguage": "all",
    "DefaultTimeRange": null,
    "DefaultCategories": null,
    "AuthToken": null,
    "CacheEnabled": true,
    "CacheTtlSeconds": 300,
    "RateLimitPerMinute": 30,
    "RateLimitWindowSeconds": 60,
    "RateLimitWaitEnabled": true,
    "RateLimitWaitMaxSeconds": 30,
    "MaxRetries": 2,
    "RetryBaseDelaySeconds": 1.0,
    "RetryMaxDelaySeconds": 10.0,
    "MaxSnippetLength": null,
    "MaxOutputChars": 0,
    "HtmlFallbackEnabled": false
  }
}
